# Copy to .env and fill in. Never commit .env.
# Atlas connection strings, one per DB user (see SPEC.md section 2)
MONGODB_URI_ADMIN=
MONGODB_URI_TASK=
MONGODB_URI_META=

# Groq (Llama) — Stream A eval + harness LLM backend
GROQ_API_KEY=
# Model ids must exist on your Groq account (list via OpenAI SDK models.list).
# Llama 3.x may be unavailable; this account uses:
GROQ_MODEL=qwen/qwen3.8-27b
TASK_MODEL=openai/gpt-oss-20b
META_MODEL=openai/gpt-oss-120b
LLM_FAKE=0

# Agent stop conditions
RSI_AUTO_EVOLVE=1
RSI_TARGET_SCORE=0.85
RSI_PLATEAU_LIMIT=2
RSI_MAX_GENERATIONS=8

# MongoDB AI (ai.mongodb.com) — accountant /api/ask
VOYAGE_API_KEY=
MONGODB_AI_ENDPOINT=https://ai.mongodb.com/v1
HX_CONCURRENCY=8
