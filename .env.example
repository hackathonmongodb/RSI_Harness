# MongoDB Atlas Sandbox (required for finalist eligibility)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rsi_harness

# LLM used only to generate mongosh from natural language (official MongoDB prompting)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Part B runtime: 1 = no network LLM (C and tests depend on this)
LLM_FAKE=1
HX_CONCURRENCY=4
