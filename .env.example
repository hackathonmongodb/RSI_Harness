# Copy to .env and fill in. .env is gitignored — never commit keys.

# LLM: any OpenAI-compatible endpoint. Defaults target Groq.
GROQ_API_KEY=
# HX_BASE_URL=https://api.groq.com/openai/v1
# HX_MODEL=openai/gpt-oss-120b          # main agent loop
# HX_FAST_MODEL=openai/gpt-oss-20b      # case relevance selection
# HX_REFLECT_MODEL=openai/gpt-oss-120b  # post-turn self-review
# HX_REASONING_EFFORT=low               # gpt-oss: low | medium | high
# HX_MAX_TOKENS=4096
# HX_CONTEXT_BUDGET=24000             # approx prompt tokens before old tool output is cleared (lower it on rate-limited free tiers)

# Memory store. Empty -> local files under HX_HOME (default ~/.hx).
MONGODB_URI=
# HX_DB=hx_memory
# HX_HOME=~/.hx

# Behaviour
# HX_AUTO_APPROVE=0      # 1 = run shell commands without asking
# HX_BASH_TIMEOUT=60
# HX_MAX_STEPS=30
# HX_NO_MEMORY=0         # 1 = baseline agent without recall / self-review
