# Copy to .env and fill in. Never commit .env.
# Atlas connection strings, one per DB user (see SPEC.md section 2)
MONGODB_URI_ADMIN=
MONGODB_URI_TASK=
MONGODB_URI_META=

# LLM
ANTHROPIC_API_KEY=
TASK_MODEL=claude-haiku-5-5
META_MODEL=claude-sonnet-5-5

# Set to 1 to return canned answers without calling the API
LLM_FAKE=0
